{
  "name": "codeflow-workspace",
  "version": "1.1.0",
  "private": true,
  "description": "CodeFlow — codebase intelligence with optional AI and MCP integrations",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "codeflow": "./cli/codeflow.mjs"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test && node --test tests/*.test.mjs tests/*.smoke.js",
    "test:legacy": "node --test tests/*.test.mjs tests/*.smoke.js",
    "start:api": "pnpm --filter @codeflow/api start",
    "mcp": "pnpm --filter @codeflow/mcp start",
    "db:migrate": "pnpm --filter @codeflow/database migrate",
    "analyze": "node card/analyze.js --path .",
    "codeflow:local": "node cli/codeflow.mjs .",
    "start:dashboard": "pnpm --filter @codeflow/dashboard dev"
  },
  "devDependencies": {
    "turbo": "^2.6.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.2.0"
    }
  }
}
