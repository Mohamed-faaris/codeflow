# Node API
HOST=localhost
PORT=4317
CODEFLOW_API_TOKEN=
CODEFLOW_AI_API_URL=http://localhost:4317
CODEFLOW_WATCH_ROOT=/absolute/path/to/your/repository
CODEFLOW_ALLOWED_ORIGINS=http://localhost:4173
CODEFLOW_ALLOWED_ROOTS=/absolute/path/to/your/repository

# PostgreSQL (pgvector extension required)
DATABASE_URL=postgresql://codeflow:codeflow@localhost:5432/codeflow
PG_POOL_MAX=10

# LLM provider selection
DEFAULT_LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
AI_REQUEST_TIMEOUT_MS=90000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=

# Any OpenAI-compatible endpoint
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
